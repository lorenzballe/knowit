rules_version = '2';

// Astut stores one document per reader, and one board per reader that a
// friend may look at. The policy: you may read and write your own, anyone
// signed in may read a board, and nothing else exists.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /readers/{uid} {
      allow read, write: if isOwner(uid);

      // Answers, judgements and saved pills: same owner, same rule. The
      // judgement log is append-only — a calibration record that can be
      // rewritten is not a record, and the app never edits one either.
      match /answers/{answerId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /judgements/{judgementId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /saved/{pillId} {
        allow read, write: if isOwner(uid);
      }
    }

    // A board is the part of a record a friend may see: streak, weeks,
    // calibration, today's squares. Anyone signed in may read one — that is
    // what a friend code is for — and only its owner may write it. Nothing
    // in a board names a card or an answer.
    match /boards/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(resource.data.uid) &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Anything not named above is closed, including reads of other readers.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
