rules_version = '2';

// Astute stores one document per reader, with what they did and what was
// dealt them under it, one board per reader that a friend may look at, a
// count per card per day of how many readers held on to it, the same count
// kept for good, and Explore as the server assembled it. The policy: you may read and write your own, anyone signed in
// may read a board or a day's counts and add one to a count, and nothing
// else exists.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A card's id as the bank writes them: science-2, thinking-d14.
    function isCardId(k) {
      return k is string && k.matches('^[a-z0-9_-]{1,64}$');
    }

    // A day as the app files it, YYYY-MM-DD in UTC, that is today on some
    // clock near now: from the day before it starts to two days after.
    function isRecentDay(day) {
      let parts = day.split('-');
      let start = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time > start - duration.value(1, 'd')
        && request.time < start + duration.value(2, 'd');
    }

    match /readers/{uid} {
      allow read, write: if isOwner(uid);

      // Answers, judgements and saved pills: same owner, same rule. The
      // judgement log is append-only — a calibration record that can be
      // rewritten is not a record, and the app never edits one either.
      match /answers/{answerId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /judgements/{judgementId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /saved/{pillId} {
        allow read, write: if isOwner(uid);
      }

      // What the reader did, a document per UTC day: the events the app
      // wrote down (see lib/sync/trace.dart), which the server reads to
      // deal them their day. Theirs to write and to read; the server's
      // functions read it with admin rights and nobody else does.
      match /activity/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['ev', 'n', 'at'])
          && request.resource.data.ev is list
          && request.resource.data.ev.size() <= 2000;
      }

      // What the server worked out about the reader, and what it dealt
      // them: read by the phone, written only by the functions. A day a
      // phone could write itself would be a day the server did not deal.
      match /profile/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /days/{day} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /explore/{doc} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // What the reader said is wrong with a card: one document per card,
      // the last thing they said (see lib/sync/reports.dart). Theirs to
      // write and to read back; the server's nightly scorecard reads them
      // with admin rights, so a card enough readers say is wrong stops
      // being dealt until somebody has looked.
      match /reports/{card} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isCardId(card)
          && request.resource.data.keys().hasOnly(
               ['card', 'reason', 'note', 'locale', 'bank', 'os', 'at'])
          && request.resource.data.card == card
          && request.resource.data.reason in
               ['fact', 'answer', 'source', 'unclear', 'typo', 'other']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.at == request.time
          && (!('locale' in request.resource.data)
              || (request.resource.data.locale is string
                  && request.resource.data.locale.size() <= 35))
          && (!('bank' in request.resource.data)
              || request.resource.data.bank is int)
          && (!('os' in request.resource.data)
              || (request.resource.data.os is string
                  && request.resource.data.os.size() <= 16));
      }
    }

    // When the reader was last here and what their clock's offset is: how
    // the nightly dealer knows whose tomorrow starts next. Theirs alone.
    match /presence/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Explore as the server put it together for everybody — the shelves and
    // the lists with the cards on them — read by every signed-in phone,
    // written only by the functions.
    match /explore/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // A board is the part of a record a friend may see: streak, weeks,
    // calibration, today's squares. Anyone signed in may read one — that is
    // what a friend code is for — and only its owner may write it. Nothing
    // in a board names a card or an answer.
    match /boards/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(resource.data.uid) &&
        request.resource.data.uid == request.auth.uid;
      // Its owner takes it down when they delete their account.
      allow delete: if isOwner(resource.data.uid);
    }

    // What readers held on to, counted by day: one document per UTC day,
    // one number per card, and nothing about who. Anyone signed in may read
    // the days, and add one — exactly one, to exactly one card — to a day
    // that is today on some clock. `k` names the card a write adds to, so
    // the rule can check that that card moved by one and nothing else moved
    // at all. No write takes anything away, and a week that is over cannot
    // be rewritten.
    match /tallies/{day} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isRecentDay(day)
        && request.resource.data.keys().hasOnly(['k', 'n'])
        && isCardId(request.resource.data.k)
        && request.resource.data.n.keys().hasOnly([request.resource.data.k])
        && request.resource.data.n[request.resource.data.k] == 1;
      allow update: if request.auth != null && isRecentDay(day)
        && request.resource.data.keys().hasOnly(['k', 'n'])
        && isCardId(request.resource.data.k)
        && request.resource.data.n.size() <= 2000
        && request.resource.data.n.diff(resource.data.n).affectedKeys()
             .hasOnly([request.resource.data.k])
        && request.resource.data.n[request.resource.data.k]
             == resource.data.n.get(request.resource.data.k, 0) + 1;
      allow delete: if false;
    }

    // The same counts kept for good: one document per shard — the part of
    // a card's id before its first dash, so science-2 is under science —
    // one number per card, nothing about who. Explore's "loved since the
    // start" is read off them. The same one-at-a-time rule as the days,
    // without the clock: a total is never over, and never taken back.
    match /totals/{shard} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['k', 'n'])
        && isCardId(request.resource.data.k)
        && request.resource.data.k.split('-')[0] == shard
        && request.resource.data.n.keys().hasOnly([request.resource.data.k])
        && request.resource.data.n[request.resource.data.k] == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['k', 'n'])
        && isCardId(request.resource.data.k)
        && request.resource.data.k.split('-')[0] == shard
        && request.resource.data.n.size() <= 5000
        && request.resource.data.n.diff(resource.data.n).affectedKeys()
             .hasOnly([request.resource.data.k])
        && request.resource.data.n[request.resource.data.k]
             == resource.data.n.get(request.resource.data.k, 0) + 1;
      allow delete: if false;
    }

    // Anything not named above is closed, including reads of other readers.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
