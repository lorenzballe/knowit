{
  "mcpServers": {
    "dart": { "command": "dart", "args": ["mcp-server"] },
    "firebase": {
      "command": "npx",
      "args": ["-y", "firebase-tools@latest", "mcp", "--dir", "."],
      "env": { "IS_FIREBASE_MCP": "true" }
    },
    "revenuecat": { "type": "http", "url": "https://mcp.revenuecat.ai/mcp" }
  }
}
