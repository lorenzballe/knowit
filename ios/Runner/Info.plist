<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Astute</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>astuto</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Astute is read upright, a card at a time, on a phone held in one
	     hand: on an iPhone it does not turn on its side. An iPad keeps every
	     orientation, because iPadOS puts every app in a window it resizes
	     and refuses an iPad app that will not turn; there the app is a
	     phone-wide column whichever way the iPad is held (_PhoneFrame). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Answers the export-compliance question at upload time instead of on
	     every build. Astute's only encryption is the HTTPS its dependencies
	     speak through the system — Firebase, RevenueCat — which is exempt.
	     Nothing here implements or bundles an algorithm of its own. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Where the reader lives, asked for once, by the app's own sheet first
	     (lib/widgets/place_ask.dart), and only "while using the app": the
	     position is read once, named on the phone, and dropped; only the
	     city is kept (docs/PLACES.md). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Astute uses your location to deal you cards about the place you live — its history, its science, its surprises. Only your city is kept, never your exact position.</string>
	<!-- The app never asks for "always". geolocator_apple, built here
	     through Swift Package Manager, cannot be given its
	     BYPASS_PERMISSION_LOCATION_ALWAYS flag, so its binary keeps a call to
	     requestAlwaysAuthorization, made only when this file has no
	     when-in-use description, which it has. Apple's upload check
	     (ITMS-90683) sees the call all the same and asks for this key, so it
	     carries the same honest sentence. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Astute uses your location to deal you cards about the place you live — its history, its science, its surprises. Only your city is kept, never your exact position.</string>
	<!-- PostHog is started from Dart, in lib/analytics.dart, because the key
	     arrives as a dart-define at build time and this file cannot read
	     one. Without
	     this the plugin would also try to start itself from keys that are
	     not here. -->
	<key>com.posthog.posthog.AUTO_INIT</key>
	<false/>
	<!-- The app has one route and reads its links itself: a widget's
	     astute://widget link is taken in AppDelegate (WidgetOpens) and handed
	     over on a channel. Left on, Flutter also pushed each link as a named
	     route the app does not have, and threw "Null check operator used on
	     a null value" from _onUnknownRoute on about half the widget taps. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<!-- Google sign-in comes back to the app through this scheme: it is the
	     REVERSED_CLIENT_ID out of GoogleService-Info.plist, and without it
	     the browser has nowhere to return to. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.582789807174-gqik2m8lr283qu6pr1s99gqgsj9lfas4</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.astuto.app.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>astute</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
