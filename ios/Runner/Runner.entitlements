<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and the App Store both deliver over the production APNs
	     environment. A build entitled only for development would take the
	     token and then never receive anything, without an error to show for
	     it. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Sign in with Apple. Without this the native sheet does not fail
	     politely: it comes back with error 1000, "authorization attempt failed
	     for an unknown reason", which is what "Could not sign in with Apple"
	     was. The App ID in the developer portal has to carry the capability
	     too, or the profile will not sign a build that asks for it. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
