    "Your days in a row, and the week.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Tage in Folge, und die Woche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus días seguidos, y la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes jours d'affilée, et la semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi giorni di fila, e la settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続日数と、この一週間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속한 날들과 이번 주."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dagen op rij, en de week."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dni z rzędu i cały tydzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus dias seguidos, e a semana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои дни подряд и вся неделя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Art arda günlerin ve hafta."
          }
        },
        "zh-Hans": {
