    "The card the morning opens on, and your streak.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karte, mit der der Morgen beginnt, und deine Serie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carta con la que empieza la mañana, y tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte qui ouvre la matinée, et ta série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La carta con cui si apre la mattina, e la tua serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝いちばんのカードと、あなたの連続記録。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침을 여는 카드와 당신의 연속 기록."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaart waarmee de ochtend opent, en je reeks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta, od której zaczyna się ranek, i twoja seria."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A carta com que abre a manhã, e a tua sequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточка, с которой начинается утро, и твоя серия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabahın açıldığı kart ve serin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清晨的第一张卡片，以及你的连续记录。"
          }
        }
      }
    },
    "The five cards of the day, and how far you are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fünf Karten des Tages, und wie weit du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cinco cartas del día, y por dónde vas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cinq cartes du jour, et où tu en es."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cinque carte del giorno, e a che punto sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の5枚と、どこまで読んだか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 카드 다섯 장과 얼마나 읽었는지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vijf kaarten van de dag, en hoe ver je bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pięć kart dnia i to, jak daleko jesteś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As cinco cartas do dia, e onde vais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять карточек дня и сколько ты уже прочитал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün beş kartı ve ne kadar ilerlediğin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的五张卡片，以及你读到了哪里。"
          }
        }
      }
    },
