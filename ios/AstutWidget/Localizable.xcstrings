{
  "sourceLanguage": "en",
  "strings": {
    "Cards from the top of Explore, the same for everyone, and only today.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karten von oben in Entdecken, für alle gleich, und nur heute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartas de lo alto de Explorar, iguales para todos, y solo hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des cartes du haut d'Explorer, les mêmes pour tous, et seulement aujourd'hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte dalla cima di Esplora, uguali per tutti, e solo oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「探す」のいちばん上のカード。みんな同じ、今日だけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탐색 맨 위의 카드들. 모두에게 같고, 오늘만."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaarten van bovenaan Ontdek, voor iedereen hetzelfde, en alleen vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty z góry Odkrywaj, te same dla wszystkich, i tylko dziś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartas do topo de Explorar, iguais para todos, e só hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки с верха «Обзора», одни на всех, и только сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keşfet'in en üstündeki kartlar, herkes için aynı, ve yalnızca bugün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「探索」顶部的卡片，人人相同，仅限今天。"
          }
        }
      }
    },
    "Five cards a day, two minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Karten, zwei Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco cartas, dos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq cartes, deux minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque carte, due minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5枚のカード、2分。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 다섯 장, 2분."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijf kaarten, twee minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pięć kart, dwie minuty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco cartas, dois minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять карточек, две минуты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş kart, iki dakika."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五张卡片，两分钟。"
          }
        }
      }
    },
    "From today's shelf": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Regal von heute"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De la estantería de hoy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l'étagère du jour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dallo scaffale di oggi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の棚から"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 선반에서"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van de plank van vandaag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z dzisiejszej półki"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da estante de hoje"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С полки дня"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün rafından"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自今日书架"
          }
        }
      }
    },
    "Open Astute to see today's five here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Astute, um hier die fünf von heute zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Astute para ver aquí las cinco de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Astute pour voir ici les cinq du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Astute per vedere qui le cinque di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuteを開くと、ここに今日の5枚が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Astute를 열면 여기에 오늘의 다섯 장이 보여요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Astute om hier de vijf van vandaag te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Astute, by zobaczyć tu dzisiejszą piątkę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Astute para veres aqui as cinco de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Astute, чтобы видеть здесь пять на сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün beşini burada görmek için Astute'u aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Astute，在这里查看今天的五张。"
          }
        }
      }
    },
