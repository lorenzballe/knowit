{
  "sourceLanguage": "en",
  "strings": {
    "Five cards a day, two minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Karten, zwei Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco cartas, dos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq cartes, deux minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque carte, due minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5枚のカード、2分。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 다섯 장, 2분."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vijf kaarten, twee minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pięć kart, dwie minuty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco cartas, dois minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять карточек, две минуты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beş kart, iki dakika."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五张卡片，两分钟。"
          }
        }
      }
    },
    "Open Astute to see today's five here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Astute, um hier die fünf von heute zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Astute para ver aquí las cinco de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Astute pour voir ici les cinq du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Astute per vedere qui le cinque di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuteを開くと、ここに今日の5枚が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Astute를 열면 여기에 오늘의 다섯 장이 보여요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Astute om hier de vijf van vandaag te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Astute, by zobaczyć tu dzisiejszą piątkę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Astute para veres aqui as cinco de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Astute, чтобы видеть здесь пять на сегодня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün beşini burada görmek için Astute'u aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Astute，在这里查看今天的五张。"
          }
        }
      }
    },
    "Open Astute to see your streak here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Astute, um hier deine Serie zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Astute para ver aquí tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Astute pour voir ta série ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Astute per vedere qui la tua serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuteを開くと、ここに連続記録が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Astute를 열면 여기에 연속 기록이 보여요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Astute om hier je reeks te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Astute, by zobaczyć tu swoją serię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Astute para veres aqui a tua sequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Astute, чтобы видеть здесь свою серию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serini burada görmek için Astute'u aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Astute，在这里查看你的连续记录。"
          }
        }
      }
    },
