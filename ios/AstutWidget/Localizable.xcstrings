    "The five cards of the day, and how far you are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fünf Karten des Tages, und wie weit du bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cinco cartas del día, y por dónde vas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cinq cartes du jour, et où tu en es."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cinque carte del giorno, e a che punto sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の5枚と、どこまで読んだか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 카드 다섯 장과 얼마나 읽었는지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vijf kaarten van de dag, en hoe ver je bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pięć kart dnia i to, jak daleko jesteś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As cinco cartas do dia, e onde vais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять карточек дня и сколько ты уже прочитал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün beş kartı ve ne kadar ilerlediğin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的五张卡片，以及你读到了哪里。"
          }
        }
      }
    },
    "The next of today's cards, then today's shelf.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Karte von heute, danach das Regal von heute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima carta de hoy, y luego la estantería de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine carte du jour, puis l'étagère du jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima carta di oggi, poi lo scaffale di oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に読む今日のカード、そのあとは今日の棚。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 읽을 다음 카드, 그다음엔 오늘의 선반."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende kaart van vandaag, daarna de plank van vandaag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następna dzisiejsza karta, a potem dzisiejsza półka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima carta de hoje, e depois a estante de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующая карточка дня, а потом полка дня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün sıradaki kartı, ardından bugünün rafı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的下一张卡片，读完后是今日书架。"
          }
        }
      }
    },
