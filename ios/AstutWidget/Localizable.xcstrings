    "Open Astute to see your streak here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Astute, um hier deine Serie zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Astute para ver aquí tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Astute pour voir ta série ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Astute per vedere qui la tua serie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuteを開くと、ここに連続記録が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Astute를 열면 여기에 연속 기록이 보여요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Astute om hier je reeks te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Astute, by zobaczyć tu swoją serię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Astute para veres aqui a tua sequência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Astute, чтобы видеть здесь свою серию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serini burada görmek için Astute'u aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Astute，在这里查看你的连续记录。"
          }
