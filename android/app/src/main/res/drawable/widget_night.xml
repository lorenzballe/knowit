<?xml version="1.0" encoding="utf-8"?>
<!-- The streak's ground: the app's night paper with two of the paywall's
     lights, violet from the top corner and teal beside it, as on the
     iPhone. Each light is its own rounded layer, so none of it spills past
     the corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141416" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="radial"
                android:centerX="0.2"
                android:centerY="0.0"
                android:gradientRadius="110dp"
                android:startColor="#332DE0D2"
                android:endColor="#002DE0D2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="radial"
                android:centerX="0.9"
                android:centerY="0.05"
                android:gradientRadius="140dp"
                android:startColor="#618B6CFF"
                android:endColor="#008B6CFF" />
        </shape>
    </item>
</layer-list>
