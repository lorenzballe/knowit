<?xml version="1.0" encoding="utf-8"?>
<!-- The dark widgets' ground: the app's night paper with the paywall's three
     lights — yellow, teal and violet — glowing in from the top. Each light
     is its own rounded layer, so none of it spills past the corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141416" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="radial"
                android:centerX="0.12"
                android:centerY="0.0"
                android:gradientRadius="120dp"
                android:startColor="#38FFE14D"
                android:endColor="#00FFE14D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="radial"
                android:centerX="0.6"
                android:centerY="0.0"
                android:gradientRadius="130dp"
                android:startColor="#2B2DE0D2"
                android:endColor="#002DE0D2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="0.2"
                android:gradientRadius="120dp"
                android:startColor="#388B6CFF"
                android:endColor="#008B6CFF" />
        </shape>
    </item>
</layer-list>
