<?xml version="1.0" encoding="utf-8"?>
<!-- The phone's own first frame, before the app draws: the logo in its tile, still, on the app's ground.
     Light phones: the dark tile on the app's paper. Dark phones (drawable-night): the light tile on black. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
    <item android:width="96dp" android:height="96dp" android:gravity="center" android:drawable="@drawable/splash_tile_dark" />
</layer-list>
