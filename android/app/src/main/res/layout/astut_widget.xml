<?xml version="1.0" encoding="utf-8"?>
<!-- The card the morning opens on, drawn the way the app draws a card: the
     subject's colour for a ground, the subject as an eyebrow, the question
     set large, and a foot with the streak. The ground is an image so the
     provider can tint it per card; RemoteViews cannot recolour a shape. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ASTUTE"
                android:textColor="#B8FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.14"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_edition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text=""
                android:textColor="#B8FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.06"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_question"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="Five cards a day, two minutes."
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="4"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_foot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#C7FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
