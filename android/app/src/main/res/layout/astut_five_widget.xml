<?xml version="1.0" encoding="utf-8"?>
<!-- Today's five in their colours, in the order they are read: a card read
     is solid with a tick, a card still to read is its colour, faint, with
     a ring. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/five_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_plain_night"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/five_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ASTUTE"
                android:textColor="#9EF2F1EC"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/five_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#F2F1EC"
                android:textSize="17sp"
                android:fontFamily="serif"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/five_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="3.5dp">

                <ImageView
                    android:id="@+id/five_fill_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_fill"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/five_ring_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_ring"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/five_check_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top|end"
                    android:padding="7dp"
                    android:text="✓"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/five_label_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|start"
                    android:paddingStart="7dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    android:text=""
                    android:textSize="7.5sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3.5dp"
                android:layout_marginEnd="3.5dp">

                <ImageView
                    android:id="@+id/five_fill_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_fill"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/five_ring_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_ring"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/five_check_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top|end"
                    android:padding="7dp"
                    android:text="✓"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/five_label_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|start"
                    android:paddingStart="7dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    android:text=""
                    android:textSize="7.5sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3.5dp"
                android:layout_marginEnd="3.5dp">

                <ImageView
                    android:id="@+id/five_fill_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_fill"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/five_ring_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_ring"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/five_check_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top|end"
                    android:padding="7dp"
                    android:text="✓"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/five_label_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|start"
                    android:paddingStart="7dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    android:text=""
                    android:textSize="7.5sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3.5dp"
                android:layout_marginEnd="3.5dp">

                <ImageView
                    android:id="@+id/five_fill_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_fill"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/five_ring_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_ring"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/five_check_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top|end"
                    android:padding="7dp"
                    android:text="✓"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/five_label_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|start"
                    android:paddingStart="7dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    android:text=""
                    android:textSize="7.5sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3.5dp"
                android:layout_marginEnd="0dp">

                <ImageView
                    android:id="@+id/five_fill_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_fill"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/five_ring_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/tile_ring"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/five_check_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="top|end"
                    android:padding="7dp"
                    android:text="✓"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/five_label_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|start"
                    android:paddingStart="7dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp"
                    android:text=""
                    android:textSize="7.5sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </FrameLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/five_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#C7F2F1EC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
