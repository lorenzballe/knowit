  "principle": "multipleComparisons",
  "question": "Each normal range spans the middle 95% of healthy people. Across 20 independent tests, what percentage of healthy people get an abnormal flag?",
  "value": 64,
  "unit": "percent",
  "answer": "About 64%.",
  "move": "Run enough checks on anything and something will look wrong.",
  "trap": "Guessing 5%, the rate for one test, for the whole panel.",
  "hint": "Work out the chance that every result lands inside its range, then subtract.",
  "steps": [
    "Chance one test comes back normal: 0.95.",
    "Chance all 20 are normal: 0.95^20 = 0.358.",
    "Chance at least one is flagged: 1 - 0.358 = 0.642.",
    "About 64%."
  ],
