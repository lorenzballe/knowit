  "hint": "Each month keeps 0.95 of the month before; square your way up.",
  "steps": [
    "Two months: 0.95 x 0.95 = 0.9025.",
    "Four months: 0.9025 x 0.9025 = 0.815.",
    "Eight months: 0.815 x 0.815 = 0.664.",
    "0.664 x 0.815 = 0.54, so 54%."
